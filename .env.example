CELESTO_PROVIDER=
CELESTO_API_KEY=
LLM_API_KEY=
LLM_MODEL=
DATABASE_URL=postgresql://timefault:replace-with-a-local-dev-password@db:5432/timefault
API_PORT=8080
POSTGRES_USER=timefault
POSTGRES_PASSWORD=replace-with-a-local-dev-password
POSTGRES_DB=timefault
# Optional: OpenAI-compatible endpoint override and cloud-runner image tag
LLM_BASE_URL=
TIMEFAULT_CLOUD_IMAGE=timefault-ai:cloud-runner

# Celesto transport used by the adapter: "cli" (default; the interface used by the first
# real cloud run) or "sdk" (not yet verified on a Celesto computer).
TIMEFAULT_CELESTO_TRANSPORT=cli

# Worker (docker compose service "worker"). It refuses to start unless
# WORKER_CONFIRM_CLOUD=yes because every run creates a billable Celesto computer.
WORKER_SCENARIO_IDS=C01
WORKER_MAX_RUNS=1
WORKER_CONFIRM_CLOUD=
