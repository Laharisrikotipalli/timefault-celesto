FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
WORKDIR /app
ENV PYTHONPATH=/app

RUN pip install --no-cache-dir \
    'psycopg[binary]==3.2.10' \
    'celesto==0.1.8' \
    'openai==3.37.0'

COPY api/ ./api/
COPY agent/ ./agent/
COPY fixtures/ ./fixtures/
COPY oracle/ ./oracle/
COPY seeds/ ./seeds/
RUN mkdir -p logs

CMD ["python", "-m", "agent.worker"]
